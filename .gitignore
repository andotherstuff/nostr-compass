# Secrets and local environment
# The publication bunker URI and client key live in ~/.config/compass-publish/
# and are never inside this repository.
.env
scripts/.env
publish/config/notify.json

# Build output and caches
public/
resources/_gen/
.hugo_build.lock
node_modules
.venv/
__pycache__/
scripts/__pycache__/
.ruff_cache/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
_cache
_site/
vendor
.bundle
pagefind/

# Git worktrees created inside the checkout by task runners
.worktrees/

# Publication pipeline: source is tracked, per-run state is not.
# out/ holds signed events and lockfiles for each issue; published.json is the
# host's ledger of what has already gone out. The durable public record of a
# publication is data/newsletter_workspace/publish_log_<date>.md plus the Nostr
# events themselves, both of which are tracked or on relays.
publish/out/
publish/published.json
publish/published.json.*
publish/*.log

# Fetcher output. Regenerated by scripts/fetch_all.sh every run; committing it
# would add megabytes of churn per week with no reviewable content.
data/project_updates/*.json
data/nip34_repos/*.json
data/nostr_nip_discussions/*.json
data/nostr_recap/*.json
data/shakespeare_apps/*.json
data/zapstore_releases/
data/app_discovery/
data/april_history/
data/non_github_sources_*.json

# Derived discovery state.
# coverage_history.json is rebuilt from published newsletters by
# scripts/build_coverage_history.py. Cross-run discovery baselines live outside
# every worktree under $COMPASS_STATE_DIR (default /opt/data/compass-state),
# because a gitignored baseline inside a fresh worktree starts empty and
# silently reports every project as new.
data/coverage_history.json

# Newsletter workspace: editorial decisions are tracked, run artifacts are not.
# triage, selection_review, review_*, handoff, coverage_review and publish_log
# are the audit trail for why an issue says what it says. Logs, PID files and
# watchdog state are per-run noise.
data/newsletter_workspace/*.log
data/newsletter_workspace/*.pid
data/newsletter_workspace/.watchdog_last_state
data/newsletter_workspace/published/
logs/
workspace/

# Local operator overlay. Host-specific scheduling, queue and notification
# wiring stays out of this repository; see skills/_COMPASS/SKILL.md.
skills/_COMPASS/LOCAL_OPS.md

# Agent tooling that is not part of the Compass system
.claude/
.opencode/
PAI_UPGRADE_SUMMARY.md
*.pai
*_pai.md
research/

# Generated podcast and publication materials
podcastnotes/
publicationnotes/

# Translation working directories
.tmp_translate*/
.tmp_*_topic_meta.json

# Transifex translations are pushed separately
.tx/translations/

# Editor and OS noise
*.swp
*.gz
*.bak
*.bak-*
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
Thumbs.db
ehthumbs.db
